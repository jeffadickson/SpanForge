{
  "stryker-config": {
    "project": "SpanForge.Protocols.csproj",
    "reporters": [
      "progress",
      "cleartext",
      "markdown",
      "json"
    ],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 80
    },
    "concurrency": 2,
    "verbosity": "info",
    "mutate": [
      "Png/PngParser.cs",
      "WebSocket/WebSocketFrameParser.cs",
      "Resp/RespParser.cs",
      "Dns/DnsParser.cs"
    ]
  }
}
