<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>

    <!-- Shared NuGet & Reproducible Build Metadata -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>SpanForge Contributors</Authors>
    <Copyright>Copyright (c) 2026 SpanForge Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jeffadickson/SpanForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jeffadickson/SpanForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>span;binary;parser;combinator;nom;winnow;binrw;zerocopy;csharp15;dotnet11;nativeaot;zero-allocation</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
