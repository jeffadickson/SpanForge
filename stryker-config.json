{
  "stryker-config": {
    "project": "SpanForge.csproj",
    "reporters": [
      "progress",
      "cleartext",
      "markdown",
      "json"
    ],
    "thresholds": {
      "high": 85,
      "low": 80,
      "break": 80
    },
    "concurrency": 2,
    "verbosity": "info",
    "mutate": [
      "Core/Needed.cs",
      "Core/Option.cs",
      "Core/ParseResult.cs",
      "Core/FastParseResult.cs",
      "Core/FastResult.cs",
      "Core/Railroad.cs",
      "Core/BitCursor.cs",
      "Core/ByteCursor.cs",
      "Core/ByteCursor.Fast.cs",
      "Core/ByteCursor.Try.cs",
      "Combinators/Parse.cs",
      "Combinators/StructParsers.cs",
      "Combinators/FastParsers.cs",
      "Streaming/StreamingDecoder.cs"
    ]
  }
}
